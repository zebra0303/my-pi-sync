{
  "name": "my-pi-sync",
  "version": "0.1.0",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./config/pi/agent/extensions"
    ],
    "skills": [
      "./config/pi/agent/skills"
    ],
    "prompts": [
      "./config/pi/agent/prompts"
    ],
    "themes": [
      "./config/pi/agent/themes"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.59.2"
  },
  "scripts": {
    "backup": "./scripts/backup.sh",
    "check": "./scripts/check.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "node --test tests/*.test.mjs",
    "prepare": "command -v husky >/dev/null 2>&1 && husky || true"
  },
  "packageManager": "pnpm@11.0.8"
}
